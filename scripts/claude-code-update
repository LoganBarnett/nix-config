#!/usr/bin/env bash

################################################################################
# Updates static.nix with a new version + per-platform checksums for
# claude-code (static.nix.claude-code; overlays/claude-code.nix hands them to
# the vendored nixpkgs derivation as its manifest).  The checksums come straight
# from the release manifest that nixpkgs's own updater reads
# (../derivations/claude-code/update.sh), converted to the SRI form static.nix
# uses, so nothing but the manifest is downloaded.  Defaults to the latest
# release; pass a version (e.g. 2.1.257) to pin a specific one.
################################################################################

set -euo pipefail

repo_root="$PWD"

base_url="https://downloads.claude.ai/claude-code-releases"

version="${1:-}"
if [ -z "${version}" ]; then
  version="$(curl --fail --silent --show-error --location "${base_url}/latest")"
fi

echo "Version: ${version}"

manifest="$(curl --fail --silent --show-error --location \
  "${base_url}/${version}/manifest.zst.json"
)"

# Manifest platform keys that correspond to Nix system identifiers.
declare -A platforms=(
  [aarch64-darwin]=darwin-arm64
  [x86_64-darwin]=darwin-x64
  [x86_64-linux]=linux-x64
  [aarch64-linux]=linux-arm64
)

declare -A hashes

for nix_system in "${!platforms[@]}"; do
  key="${platforms[$nix_system]}"
  checksum="$(jq --raw-output --arg key "${key}" \
    '.platforms[$key].checksum // empty' <<< "${manifest}"
  )"
  if [ -z "${checksum}" ]; then
    echo "No ${key} entry in the ${version} manifest." >&2
    exit 1
  fi
  hashes[${nix_system}]="$(nix hash to-sri --type sha256 "${checksum}")"
  echo "  ${nix_system}: ${hashes[$nix_system]}"
done

# Update static.nix.
cd "${repo_root}"

nix-editor \
  static.nix \
  'claude-code.version' \
  --val "\"${version}\"" \
  --inplace

for nix_system in "${!hashes[@]}"; do
  nix-editor \
    static.nix \
    "claude-code.${nix_system}.hash" \
    --val "\"${hashes[$nix_system]}\"" \
    --inplace
done

# Final formatting pass.
nix-editor \
  static.nix \
  'claude-code.version' \
  --val "\"${version}\"" \
  --inplace \
  --format

echo "Done.  Updated static.nix to claude-code ${version}."
