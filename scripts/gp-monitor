#!/usr/bin/env bash

################################################################################
# Monitor GlobalProtect VPN connection and reconnect if disconnected.
# This script is designed to run continuously as a background service.
################################################################################

set -e

# Configuration (can be overridden by environment variables)
GP_SERVER="${GP_SERVER:-}"
GP_GATEWAY="${GP_GATEWAY:-}"
GP_USERNAME="${GP_USERNAME:-}"
ORG_NAME="${ORG_NAME:-}"
GP_CHECK_INTERVAL="${GP_CHECK_INTERVAL:-60}"
GP_LOG_DIR="${GP_LOG_DIR:-$HOME/.local/share/gpclient/logs}"
GP_MONITOR_LOG="${GP_MONITOR_LOG:-$GP_LOG_DIR/monitor.log}"

# Parse arguments
while [[ $# -gt 0 ]]; do
  case $1 in
    --server)
      GP_SERVER="$2"
      shift 2
      ;;
    --gateway)
      GP_GATEWAY="$2"
      shift 2
      ;;
    --username)
      GP_USERNAME="$2"
      shift 2
      ;;
    --org-name)
      ORG_NAME="$2"
      shift 2
      ;;
    --check-interval)
      GP_CHECK_INTERVAL="$2"
      shift 2
      ;;
    -h|--help)
      echo "Usage: gp-monitor [OPTIONS]"
      echo ""
      echo "Monitor GlobalProtect VPN connection and reconnect if disconnected."
      echo "Uses gp-connect-auto for fully automated SSO + TOTP authentication."
      echo ""
      echo "Options:"
      echo "  --server TEXT           Portal server URL (required)"
      echo "  --gateway TEXT          Gateway to connect to (optional)"
      echo "  --username TEXT         VPN username/email (required)"
      echo "  --org-name TEXT         Organization name for pass entries (required)"
      echo "  --check-interval N      Seconds between connection checks (default: 60)"
      echo "  -h, --help              Show this help message"
      echo ""
      echo "Environment Variables:"
      echo "  GP_SERVER               Portal server URL"
      echo "  GP_GATEWAY              Gateway to connect to"
      echo "  GP_USERNAME             VPN username/email"
      echo "  ORG_NAME                Organization name for pass entries"
      echo "  GP_CHECK_INTERVAL       Seconds between checks (default: 60)"
      echo "  GP_LOG_DIR              Log directory (default: ~/.local/share/gpclient/logs)"
      echo "  GP_MONITOR_LOG          Monitor log file (default: \$GP_LOG_DIR/monitor.log)"
      exit 0
      ;;
    *)
      echo "Error: Unknown option $1"
      echo "Use -h or --help for usage information"
      exit 1
      ;;
  esac
done

if [ -z "$GP_SERVER" ]; then
  echo "Error: Portal server is required (GP_SERVER)"
  echo "Use -h or --help for usage information"
  exit 1
fi

if [ -z "$GP_USERNAME" ]; then
  echo "Error: Username is required (GP_USERNAME)"
  echo "Use -h or --help for usage information"
  exit 1
fi

if [ -z "$ORG_NAME" ]; then
  echo "Error: Organization name is required (ORG_NAME)"
  echo "Use -h or --help for usage information"
  exit 1
fi

# Create log directory if it doesn't exist
mkdir -p "$GP_LOG_DIR"

# Logging function
log() {
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" | tee -a "$GP_MONITOR_LOG"
}

# Check if VPN is connected
is_connected() {
  # Check if gpclient is running and has established a connection.
  # Look for the PID file and verify the process is running.
  # Note: We use ps -o pid= because gpclient runs as root but the monitor runs
  # as user, and macOS ps with -p flag can exit with non-zero status due to
  # entitlement warnings even when the process exists.
  if [ -f /var/run/gpclient.lock ]; then
    PID=$(cat /var/run/gpclient.lock 2>/dev/null)
    if [ -n "$PID" ] && [ -n "$(ps -o pid= -p "$PID" 2>/dev/null)" ]; then
      return 0
    fi
  fi
  return 1
}

# The internal host every DNS probe below resolves.  Comes from
# $GP_AUTO_CONFIG (services.globalprotect-monitor.testHost).  Empty when
# unset, in which case callers skip probing.
dns_test_host() {
  jq -r '.testHost' "$GP_AUTO_CONFIG" 2>/dev/null || echo ""
}

################################################################################
# Three DNS resolution paths, three probes.
#
# This host resolves corporate names by three different routes, configured by
# three different mechanisms, which fail independently:
#
#   1. mDNSResponder     — what ping, curl, and macOS applications use.
#                          Configured by /etc/resolver/<domain> files and the
#                          synthetic scutil services vpnc-script-macos creates.
#   2. dnsmasq           — /etc/resolv.conf points at 127.0.0.1, so anything
#                          reading resolv.conf directly instead of going
#                          through getaddrinfo lands here.  That is most
#                          Nix-built tooling: dig, curl built against c-ares,
#                          and similar.  Configured by
#                          /var/run/dnsmasq-vpn-servers.conf plus a SIGHUP.
#   3. The VPN nameserver itself — the upstream both of the above forward to.
#
# Probing only one of these reports healthy while a whole class of program is
# broken.  A cached NXDOMAIN in mDNSResponder once survived ~19 hours behind a
# dig-only probe, because dig never touches mDNSResponder.  The reverse is
# equally possible: a stale dnsmasq servers-file breaks every Nix tool while
# macOS applications resolve fine.
#
# The three probes exist to tell those apart, because they need different
# remedies — see the escalation ladder in the monitor loop.
################################################################################

# Path 2: through /etc/resolv.conf -> 127.0.0.1 -> dnsmasq.  Note this is NOT
# a direct query to the VPN nameserver; dig only reaches it via the forwarder.
forwarder_path_ok() {
  local test_domain="$1"
  if ! command -v dig >/dev/null 2>&1; then
    return 1
  fi
  dig +short +time=2 +tries=1 "$test_domain" >/dev/null 2>&1
}

# Path 1: through mDNSResponder, the macOS system resolver.  dig cannot see
# this path at all.
#
# Short arguments only: dscacheutil has no long-option form.  -q selects the
# category to query, -a the key to match on.
system_resolver_path_ok() {
  local test_domain="$1"
  local result
  # dscacheutil exits 0 even when the lookup finds nothing, so check the
  # output for an address line rather than trusting the exit status.
  result=$(dscacheutil -q host -a name "$test_domain" 2>/dev/null || echo "")
  case "$result" in
    # Matches both ip_address: and ipv6_address:.
    *_address:*) return 0 ;;
  esac
  return 1
}

# The VPN nameserver the other two paths forward to.  Read from the resolver
# files vpnc-script-macos wrote at connect, which is the same value that goes
# into the dnsmasq servers-file.
vpn_nameserver() {
  local domain
  domain=$(dns_test_host)
  [ -z "$domain" ] && return 1
  # /etc/resolver matches on suffix, so walk the labels off the test host
  # until a resolver file exists for the remaining domain.
  while [ -n "$domain" ]; do
    if [ -r "/etc/resolver/$domain" ]; then
      awk '/^nameserver/ {print $2; exit}' "/etc/resolver/$domain"
      return 0
    fi
    case "$domain" in
      *.*) domain="${domain#*.}" ;;
      *) break ;;
    esac
  done
  return 1
}

# Path 3: straight at the VPN nameserver, bypassing both forwarders.  This is
# what distinguishes "a forwarder is misconfigured" from "the tunnel is down".
upstream_nameserver_ok() {
  local test_domain="$1"
  local server
  if ! command -v dig >/dev/null 2>&1; then
    return 1
  fi
  server=$(vpn_nameserver) || return 1
  [ -z "$server" ] && return 1
  dig +short +time=2 +tries=1 "@$server" "$test_domain" >/dev/null 2>&1
}

# Check if VPN DNS is working for internal domains across every path a
# program might take.  Any one failing is a real outage for some class of
# program, so all must pass.
is_dns_working() {
  local test_domain
  test_domain=$(dns_test_host)
  if [ -z "$test_domain" ]; then
    echo "is_dns_working: no testHost configured — skipping probe" >&2
    return 1
  fi
  if forwarder_path_ok "$test_domain" \
    && system_resolver_path_ok "$test_domain"; then
    return 0
  fi
  return 1
}

# Flush the system DNS cache and restart mDNSResponder.
#
# $GP_MONITOR_LOG is owned by the user running gp-monitor; the redirect
# lands in that user's file, not root's — sudo affecting only the inner
# command is correct here.
flush_dns_cache() {
  # shellcheck disable=SC2024
  if sudo dns-resolver-helper flush-cache >> "$GP_MONITOR_LOG" 2>&1; then
    log "DNS cache flushed"
    return 0
  fi
  log "WARNING: dns-resolver-helper flush-cache failed"
  return 1
}

# Byte offset into $GP_MONITOR_LOG that rekey_detected has already scanned.
GP_LOG_OFFSET=0
if [ -f "$GP_MONITOR_LOG" ]; then
  GP_LOG_OFFSET=$(wc --bytes < "$GP_MONITOR_LOG" | tr --delete ' ')
fi

# Detect an openconnect session rekey since the last call.
#
# gp-connect-auto is backgrounded with stdout/stderr redirected into
# $GP_MONITOR_LOG, so openconnect's own reconnect chatter lands there.  Those
# rekeys (roughly hourly) drop and re-establish the tunnel *without* gpclient
# exiting, so is_connected never goes false and connect()'s post-connect
# flush never fires.  Any name looked up during that window can pick up a
# cached NXDOMAIN, and repeated querying then keeps the entry hot in
# mDNSResponder well past the zone's negative TTL.
#
# The symptom probe in the monitor loop only covers testHost, but any name
# can be the one that got poisoned — so watch for the rekey itself and flush
# regardless of which name was in flight.
rekey_detected() {
  local size new
  size=$(wc --bytes < "$GP_MONITOR_LOG" | tr --delete ' ') || return 1
  # Rotated or truncated out from under us — resync and skip a round.
  if [ "$size" -lt "$GP_LOG_OFFSET" ]; then
    GP_LOG_OFFSET="$size"
    return 1
  fi
  if [ "$size" -eq "$GP_LOG_OFFSET" ]; then
    return 1
  fi
  # --bytes=+N is 1-indexed from the start of the file.
  new=$(tail --bytes=+$((GP_LOG_OFFSET + 1)) "$GP_MONITOR_LOG" 2>/dev/null \
    || echo "")
  GP_LOG_OFFSET="$size"
  # Keep this marker out of the messages this script logs itself, or the
  # next poll would read its own line back and flush forever.
  case "$new" in
    *attempt-reconnect*) return 0 ;;
  esac
  return 1
}

# Restore the default gateway if the VPN tunnel dropped without running the
# vpnc-script disconnect case (e.g. killed with SIGKILL).  Without this, the
# machine loses all internet access when the VPN disconnects.
restore_default_gateway_if_needed() {
  local gateway_file="/var/run/vpnc-default-gateway"
  if [ ! -f "$gateway_file" ]; then
    return 0
  fi

  # Read the saved gateway before the VPN overrode the default route.
  read -r SAVED_GW SAVED_IF < "$gateway_file" || return 0

  # Check if the current default route is through a utun interface.
  local current_if
  current_if=$(route -n get default 2>/dev/null | awk '/interface:/{print $2}')
  if echo "$current_if" | grep -q "^utun"; then
    # Verify the VPN tunnel is actually down.
    if ! is_connected; then
      log "WARNING: Default route is via dead tunnel ($current_if) - restoring $SAVED_GW via $SAVED_IF"
      route delete default 2>/dev/null || true
      if route add default "$SAVED_GW" 2>/dev/null; then
        log "Default gateway restored: $SAVED_GW via $SAVED_IF"
      else
        log "ERROR: Failed to restore default gateway"
      fi
      rm -f "$gateway_file"
    fi
  fi
}

# Disconnect function
disconnect() {
  log "Disconnecting from GlobalProtect VPN..."
  gpclient disconnect || true
  sleep 2
}

# Connect function
connect() {
  log "Connecting to GlobalProtect VPN using automated authentication..."
  log "Server: $GP_SERVER"
  if [ -n "$GP_GATEWAY" ]; then
    log "Gateway: $GP_GATEWAY"
  fi
  log "User: $GP_USERNAME"

  # Use gp-connect-auto for fully automated connection.
  # This handles SSO, TOTP, and tunnel creation automatically.
  # Use sudo -E to preserve environment while gaining tunnel creation privileges.
  # shellcheck disable=SC2024
  sudo -E gp-connect-auto >> "$GP_MONITOR_LOG" 2>&1 &
  CONNECT_PID=$!

  log "Automated connection process started (PID: $CONNECT_PID)"

  # Wait for connection to establish (with timeout)
  # Increased timeout for automated authentication flow
  WAIT_COUNT=0
  MAX_WAIT=120
  while [ $WAIT_COUNT -lt $MAX_WAIT ]; do
    if is_connected; then
      log "VPN connection established successfully"

      # Fix DNS scoping on macOS.  Two parts:
      #
      #   1. dns-vpn-scoping-fix discovers VPN DNS servers via scutil --dns
      #      and writes /etc/resolver entries for them.  It's expected to
      #      succeed when the gateway pushes CISCO_SPLIT_DNS entries with
      #      DNS servers outside the tunnel-IP range (10.89.x.x here).  On
      #      gateways that fall back to the tunnel-IP DNS (10.89.34.1),
      #      scutil contains no matching entries and the script exits 1;
      #      that's fine because vpnc-script-macos already wrote the same
      #      /etc/resolver files during connect.  Retry briefly with a 1s
      #      backoff for the scutil-populates-late race, but treat the
      #      no-servers exit as informational.
      #
      #   2. Restart mDNSResponder.  vpnc-script-macos deferred this on
      #      purpose — the tunnel data plane wasn't ready while it ran, so
      #      restarting mDNSResponder then would have evaluated VPN DNS
      #      reachability with a dead tunnel and marked the servers down.
      #      The data plane is now confirmed up (is_connected returned
      #      true), so we are the "harness" referenced in the deferred
      #      message.  Flush dscacheutil + HUP mDNSResponder so any
      #      pre-VPN NXDOMAINs (or stale resolutions across a reconnect)
      #      are cleared.
      log "Fixing DNS scoping for VPN interface..."
      SCOPING_TRIES=0
      SCOPING_MAX=5
      while [ "$SCOPING_TRIES" -lt "$SCOPING_MAX" ]; do
        if dns-vpn-scoping-fix >> "$GP_MONITOR_LOG" 2>&1; then
          log "DNS scoping fixed after ${SCOPING_TRIES}s"
          break
        fi
        SCOPING_TRIES=$((SCOPING_TRIES + 1))
        sleep 1
      done
      if [ "$SCOPING_TRIES" -ge "$SCOPING_MAX" ]; then
        log "DNS scoping fix found no VPN DNS in scutil — vpnc-script-macos already configured /etc/resolver, continuing"
      fi
      log "Flushing DNS cache and HUPing mDNSResponder..."
      flush_dns_cache || true

      return 0
    fi
    sleep 1
    WAIT_COUNT=$((WAIT_COUNT + 1))
  done

  log "WARNING: VPN connection did not establish within $MAX_WAIT seconds"
  return 1
}

# Main monitoring loop
log "Starting GlobalProtect VPN monitor"
log "Check interval: ${GP_CHECK_INTERVAL}s"

# Initial connection attempt
if ! is_connected; then
  log "VPN is not connected, initiating connection..."
  connect
else
  log "VPN is already connected"
fi

# Monitor loop
while true; do
  sleep "$GP_CHECK_INTERVAL"

  # Safety net: if a prior connection left the default route pointing at a dead
  # tunnel, restore the original gateway before attempting anything else.
  restore_default_gateway_if_needed

  if ! is_connected; then
    log "VPN connection lost, attempting to reconnect..."
    disconnect
    sleep 2
    connect
    continue
  fi

  # A session rekey re-established the tunnel underneath us without ever
  # going through connect().  Flush now, before the next lookup inherits an
  # NXDOMAIN cached during the window the rekey left behind.
  if rekey_detected; then
    log "openconnect session rekey seen, flushing DNS cache..."
    flush_dns_cache || true
  fi

  TEST_HOST=$(dns_test_host)

  # Escalation ladder, cheapest repair first.  The two forwarder paths fail
  # independently and need different remedies, so decide from the pair which
  # one is actually broken rather than reconnecting on any DNS fault.
  #
  #   forwarder | system resolver | meaning              | remedy
  #   ----------+-----------------+----------------------+------------------
  #   ok        | ok              | healthy              | none
  #   ok        | broken          | mDNSResponder cache  | flush
  #   broken    | ok              | dnsmasq stale/down   | HUP, then escalate
  #   broken    | broken          | tunnel or scoping    | scoping fix/reconnect
  if [ -n "$TEST_HOST" ]; then
    FORWARDER_OK=false
    SYSRES_OK=false
    forwarder_path_ok "$TEST_HOST" && FORWARDER_OK=true
    system_resolver_path_ok "$TEST_HOST" && SYSRES_OK=true

    # mDNSResponder holds a stale or poisoned entry while everything else
    # resolves.  Flush rather than tearing down a working VPN.
    if [ "$FORWARDER_OK" = true ] && [ "$SYSRES_OK" = false ]; then
      log "Forwarder resolves $TEST_HOST but the macOS system resolver does" \
        "not — flushing stale DNS cache..."
      flush_dns_cache || true
      sleep 2
      if system_resolver_path_ok "$TEST_HOST"; then
        log "DNS resolution restored by cache flush"
        continue
      fi
      log "System resolver still failing after flush, escalating..."
    fi

    # The macOS side resolves but the dnsmasq side does not, so the tunnel is
    # fine and only Nix-built tooling is broken.  If the VPN nameserver still
    # answers directly, dnsmasq is the faulty link — reload it before
    # considering anything as disruptive as a reconnect.
    if [ "$FORWARDER_OK" = false ] && [ "$SYSRES_OK" = true ]; then
      if upstream_nameserver_ok "$TEST_HOST"; then
        log "VPN nameserver answers directly but the dnsmasq forwarder does" \
          "not — reloading dnsmasq..."
        # Absolute path and exact arguments so this matches the NOPASSWD rule
        # in global-protect-persistent.nix; --non-interactive so a rule that
        # ever stops matching fails fast instead of hanging the daemon on a
        # password prompt.
        if sudo --non-interactive /usr/bin/killall -HUP dnsmasq 2>/dev/null; then
          sleep 2
          if forwarder_path_ok "$TEST_HOST"; then
            log "Forwarder resolution restored by dnsmasq reload"
            continue
          fi
        fi
        # A reload cannot fix a servers-file whose contents are stale; only
        # re-running vpnc-script-macos rewrites it, which means a reconnect.
        log "dnsmasq still failing after reload — servers-file is likely" \
          "stale, escalating..."
      else
        log "Neither the dnsmasq forwarder nor the VPN nameserver answers" \
          "for $TEST_HOST, escalating..."
      fi
    fi
  fi

  if ! is_dns_working; then
    log "VPN DNS resolution is broken, attempting to fix..."
    # Try to fix DNS scoping first without full reconnect.
    if dns-vpn-scoping-fix >> "$GP_MONITOR_LOG" 2>&1; then
      log "DNS scoping fix applied successfully"
      # Verify DNS is now working.
      sleep 2
      if is_dns_working; then
        log "DNS resolution restored"
      else
        log "DNS still broken after scoping fix, triggering full reconnect..."
        disconnect
        sleep 2
        connect
      fi
    else
      log "DNS scoping fix failed, triggering full reconnect..."
      disconnect
      sleep 2
      connect
    fi
  else
    log "VPN connection and DNS are active"
  fi
done
