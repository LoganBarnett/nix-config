#!/usr/bin/env bash

################################################################################
# Must be run from $FLAKE_ROOT (the repo root containing flake.nix), since
# rsync uses ./ as the source.  macOS ships a very old rsync; a future
# derivation should use pkgs.rsync explicitly.
#
# This script aims at faking some of the remote build stuff Nix claims to
# support.  It is the break-glass fallback for proton-deploy.  Installing a new
# host is not one of those cases.  That is `proton-deploy install`, which wraps
# nixos-anywhere.
#
# The problem:
# I can't figure out how to get Nix to deploy to another machine.  I've tried:
# 1. Writing the image to disk: QEMU segfault with a funky, trimmed down glibc
#    that I can't get rid of.
# 2. nixos-rebuild switch --target host - same problem:  It doesn't want to
#    build on the target host.  Probably because I don't have it setup as a
#    build machine.  Further investigation is needed there.
# 3. Praying to the machine god.  Offerings made according to specifications.
#    Prayers have gone unanswered, or a long journey of discovery awaits.
# 4. Using deploy-rs.  Same cross-build issues.
# 5. Using nixos-anywhere.  Same cross-build issues at the time.  It works now
#    that silicon serves as the x86_64-linux builder.
# 6. Using nixos-generate.  Same cross-build issues.
#
# The common theme seems to be cross compiling from aarch64 to x86_64, which is
# apparently not a direction many folks travel in.  Usually it goes in the other
# direction (x86_64 to aarch64).  There's some deep assumptions built into the
# build process as a result, I think.
#
# I've found that the manual is basically not be trusted.  Blog posts are far
# too outdated, or claims are made under a different arrangement of platforms.
# The message has been "read the code lol", to which I have done but I am just
# not deep enough into it with 4 weeks of massive personal time put into this.
################################################################################

set -euo pipefail

if [[ "${CLAUDECODE:-0}" == "1" ]] && [[ "${CLAUDE_WAS_TOLD_TO_USE_REMOTE_DEPLOY_EXPLICITLY:-0}" != "1" ]]; then
  echo "The remote-deploy script should only be run if the user granted" >&2
  echo "you explicit instruction to run it.  If you were not given explicit" >&2
  echo "permission, use \`caffeinate proton-deploy switch <host>\`.  If you" >&2
  echo "are running into problems with that invocation, halt and ask the" >&2
  echo "user for instruction." >&2
  exit 1
fi

if [[ -z "${FLAKE_ROOT:-}" ]] || [[ ! -f "$FLAKE_ROOT/flake.nix" ]]; then
  echo "error: FLAKE_ROOT is not set or does not contain flake.nix." >&2
  echo "Run from the repo root or set FLAKE_ROOT." >&2
  exit 1
fi
cd "$FLAKE_ROOT"

build=false
cleanup=true
switch=true

cleanup_remote() {
  # With --no-switch the user intends to run the deployment manually, so the
  # working tree must remain.
  if [[ "$switch" != true || "$cleanup" != true ]]; then
    return 0
  fi
  # sudo is required because nixos-rebuild claims one or more of the .git
  # files, leaving them root-owned.
  # || true prevents a transient SSH failure here from masking the exit code
  # of a successful deployment.
  #
  # We intend that this expands on the client side of our SSH invocation, so
  # disable the warning.
  # shellcheck disable=SC2029
  ssh "$ssh_user@$host" "sudo rm -rf ~$ssh_user/proton-nix" || true
}

while true; do
  case "${1:-}" in
    -h | --help)
      cat <<EOH
Usage: $0 [opts] <hostname>

  --build              Indicate we should do a \`nix build\` instead of \`nixos
                       rebuild switch\`. Default: false.

  --no-cleanup         Do not remove ~/proton-nix from the remote after
                       deployment.  Sensitive files from the repo may be
                       present there.  Default: remove after deployment.

  --no-switch          Do not \`nixos-rebuild switch\` - just copy the files.
                       This can be helpful for running this session over tmux.
                       Skips cleanup so the working tree remains for manual
                       use.

  --user <user>        SSH as this user instead of the one ssh_config resolves
                       for the host.

Copies nix files to a host via rsync over SSH, and attempts to do a
\`nixos-rebuild switch\`.

EOH
      exit
      ;;
    --no-cleanup)
      cleanup=false
      shift 1
      ;;
    --no-switch)
      switch=false
      shift 1
      ;;
    --build)
      build=true
      shift 1
      ;;
    --user)
      ssh_user="${2:-}"
      shift 2
      ;;
    * ) break ;;
  esac
done
host="${1:-}.proton"
target="${1:-}"
shift
if [[ -z "${ssh_user-}" ]]; then
  ssh_user="$(ssh -G "$host" | awk '$1 == "user" { print $2 }')"
fi
echo "Deploying $target to $ssh_user@$host..."
trap cleanup_remote EXIT
# rsync is ideal, but needs to be present on the remote machine.  We don't have
# that setup yet - or at least I have old installer without it.  Next time we
# look, switch.
# We exclude .git because we do a `git init && git add .` on the remote side,
# and this creates a .git directory.  This will prevent rsync from deleting the
# .git directory and then subsequently our script recreates it.  The process is
# very slow and we're going to update the staged state anyways.
# Don't copy symlinks.  I rarely desire to treat symlinks differently, but in
# this case we wind up copying iso files over and the like.  But I haven't found
# an argument to do that yet.
rsync \
  --archive \
  --verbose \
  --human-readable \
  --delete-after \
  --exclude='result' \
  --exclude='.git' \
  ./ "$host"':~/proton-nix'
if [[ "$build" == true ]]; then
  nix_command='nix build'
else
  nix_command='nixos-rebuild switch --accept-flake-config'
fi
remote_command="set -x; cd proton-nix ;
  sudo $nix_command --flake '.#$target' --show-trace --impure"
ssh "$ssh_user@$host" "\
set -e; \
set -x; \
cd proton-nix && \
git init && \
git add . \
"
if [[ "$switch" == true ]]; then
  # shellcheck disable=SC2029
  ssh "$ssh_user@$host" "$remote_command"
else
  echo "Switch skipped.  You can run manually:"
  echo "$remote_command"
fi
