#!/usr/bin/env bash
################################################################################
# Used for installing the host key on the system if it isn't automatically setup
# already (such as is the case for macOS systems).  Without doing this,
# attempting to start the launch daemon will show this:
# [agenix] WARNING: no readable identities found!
# age: error: no identity matched any of the recipients
# And the launch daemon will fail.
# One can get a print out of this (it won't show up in Console.app) by doing
# `sudo launchctl print system/org.nixos.activate-agenix` to show the script.
# Copy the path seen in the arguments entry, and prefix the command with sudo.
# Remember that if a new generation of your configuration is built that you will
# need to get the path to the executable again.
################################################################################

set -euo pipefail

if [[ -z "${FLAKE_ROOT:-}" ]]; then
  echo "error: FLAKE_ROOT is not set.  Source your shell profile first." >&2
  exit 1
fi

secretsDir="$FLAKE_ROOT/secrets"
host=$(hostname -s)

master_identity_name="$(
  nix eval --raw --file "$FLAKE_ROOT/secrets/master-identity.nix" identity
)"
# agenix-rekey coerces hostPubkey to the key's content, so this holds the key
# itself rather than a file path.
host_pubkey_content="$(
  nix eval --raw \
    "$FLAKE_ROOT#darwinConfigurations.\"$host\".config.age.rekey.hostPubkey" \
    2>/dev/null \
  || nix eval --raw \
    "$FLAKE_ROOT#nixosConfigurations.\"$host\".config.age.rekey.hostPubkey"
)"
# The private half sits alongside the committed public key under the same
# stem, but encrypted to the master key with an .age extension.  Since the
# configuration only yields the key's content, find the committed file by
# content match to learn the stem.
host_pubkey_file=""
for candidate in "$secretsDir"/*.pub; do
  if [[ "$(cat "$candidate")" == "$host_pubkey_content" ]]; then
    host_pubkey_file="$candidate"
    break
  fi
done
if [[ -z "$host_pubkey_file" ]]; then
  echo "error: No .pub under secrets/ matches this host's age.rekey.hostPubkey." >&2
  exit 1
fi
rage \
  --identity "$secretsDir/$master_identity_name" \
  --decrypt "${host_pubkey_file%.pub}.age" \
  | sudo tee /etc/ssh/ssh_host_ed25519_key >/dev/null
# tee leaves the file world-readable, which a private key must never be.
sudo chmod 600 /etc/ssh/ssh_host_ed25519_key

printf '%s\n' "$host_pubkey_content" \
  | sudo tee /etc/ssh/ssh_host_ed25519_key.pub >/dev/null
