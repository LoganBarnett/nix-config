# EAP configuration for the proton network.  Managed by nix-config
# (nixos-configs/freeradius.nix); overlaid onto the upstream example raddb.
#
# UNVALIDATED: FreeRADIUS configs are landed by iterating `radiusd -X` against a
# live authenticator.  There is no access point to test against yet, so treat
# every directive here as a starting point, not a proven config.
eap {
	default_eap_type = ttls
	timer_expire     = 60
	ignore_unknown_eap_types = no
	cisco_accounting_username_bug = no

	# Server credentials for the outer TLS tunnel.  The private key arrives via
	# systemd LoadCredential (kept out of the world-readable Nix store); the
	# certificate, CA, and DH params are injected into certs/ by the raddb
	# derivation in freeradius.nix.  ${certdir} = ${confdir}/certs.
	tls-config tls-common {
		private_key_file = /run/credentials/freeradius.service/radius-key
		certificate_file = ${certdir}/radius.crt
		ca_file          = ${certdir}/ca.pem
		dh_file          = ${certdir}/dh
		ecdh_curve       = "prime256v1"
		cipher_list      = "HIGH"
		tls_min_version  = "1.2"
		tls_max_version  = "1.3"
		fragment_size    = 1024
	}

	# EAP-TLS (client certificates) — reserved for the per-device IoT tier we
	# will add later.  Defined so the type exists; nothing selects it yet.
	tls {
		tls = tls-common
	}

	# EAP-TTLS — the password tier.  The inner PAP exchange is delegated to the
	# inner-tunnel virtual server, which verifies the password by binding to
	# LDAP as the user.
	ttls {
		tls = tls-common
		default_eap_type       = md5
		copy_request_to_tunnel = yes
		use_tunneled_reply     = yes
		virtual_server         = "inner-tunnel"
	}
}
